}
-keep,includedescriptorclasses class com.kova.workstation.data.model.**$$serializer { *; }
-keepclassmembers class com.kova.workstation.data.model.** {
    *** Companion;
}
-keepclasseswithmembers class com.kova.workstation.data.model.** {
