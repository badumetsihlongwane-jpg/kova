<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext when user connects through Tailscale / WireGuard / local LAN with --no-tls -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
